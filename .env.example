# ArchOpt Environment Configuration Template
APP_NAME="AI Campus Planner Backend"
DEBUG=True

# Database Configuration
# Port 5433 is default for dedicated container; use 5432 for default local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/campus_planner

# Security: REQUIRED (Pydantic Settings requires SECRET_KEY)
# For HS256, RFC 7518 Section 3.2 recommends 32+ characters
SECRET_KEY=archopt_development_super_secret_key_32_bytes_min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Pipeline Mode: "mock" (default) or "real" (requires P1/P2/P3 modules)
PIPELINE_MODE=mock
